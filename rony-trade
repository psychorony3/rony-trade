            t.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${msg}</span>`;
            c.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3000);
        }

        // Copy Link
        function copyAffiliateLink() {
            navigator.clipboard.writeText('https://polymarket.com/?via=rony-j6jh');
            showToast('Polymarket Affiliate Link Copied!');
        }

        // Web3 Wallet Connect Mock
        function connectWallet() {
            showToast('MetaMask / Web3 Wallet Connected!');
            login();
        }

        // Login Action
        function login() {
            let v = document.getElementById('email').value || 'Rony_201000';
            document.getElementById('uName').innerText = v;
            document.getElementById('loginPage').classList.add('hidden');
            document.getElementById('tradePage').classList.remove('hidden');
            document.getElementById('tradePage').classList.add('flex');

            initTV(currentPairSymbol);
            startPriceTicker();
            showToast('Welcome to RONY TRADE Pro Terminal');
        }

        // Logout Action
        function logout() {
            document.getElementById('tradePage').classList.add('hidden');
            document.getElementById('tradePage').classList.remove('flex');
            document.getElementById('loginPage').classList.remove('hidden');
            showToast('Logged out successfully', 'fa-right-from-bracket');
        }

        // Initialize TradingView Chart
        function initTV(symbol) {
            document.getElementById('tv').innerHTML = '';
            tvWidget = new TradingView.widget({
                autosize: true,
                symbol: symbol,
                interval: "15",
                timezone: "Etc/UTC",
                theme: "dark",
                style: "1",
                locale: "en",
                enable_publishing: false,
                backgroundColor: "#0c0c0f",
                gridColor: "rgba(255, 255, 255, 0.03)",
                container_id: "tv"
            });
        }

        // Pair Switcher
        function switchPair(symbol, label, basePrice) {
            currentPairSymbol = symbol;
            currentPrice = basePrice;
            document.getElementById('currentPairText').innerText = label;
            
            ['BTC', 'ETH', 'SOL'].forEach(p => {
                const btn = document.getElementById(`tab-${p}`);
                if (label.startsWith(p)) {
                    btn.className = "px-3 py-1.5 rounded-lg font-bold bg-[#b6ff4a] text-black transition";
                } else {
                    btn.className = "px-3 py-1.5 rounded-lg font-bold text-zinc-400 hover:text-white transition";
                }
            });

            initTV(symbol);
            showToast(`Switched pair to ${label}`);
        }

        // Set Long / Short Side
        function setSide(side) {
            selectedSide = side;
            const bLong = document.getElementById('btnLong');
            const bShort = document.getElementById('btnShort');
            const submitBtn = document.getElementById('tradeSubmitBtn');

            if (side === 'LONG') {
                bLong.className = "bg-emerald-500 text-black py-2.5 rounded-xl font-black text-xs transition glow-accent-sm";
                bShort.className = "bg-white/5 border border-white/10 text-zinc-400 py-2.5 rounded-xl font-black text-xs hover:bg-red-500/20 hover:text-red-400 transition";
                submitBtn.className = "w-full bg-[#b6ff4a] text-black py-3.5 rounded-xl font-black text-xs tracking-wider uppercase hover:bg-white transition";
                submitBtn.innerText = "EXECUTE LONG POSITION";
            } else {
                bShort.className = "bg-red-500 text-white py-2.5 rounded-xl font-black text-xs transition glow-accent-sm";
                bLong.className = "bg-white/5 border border-white/10 text-zinc-400 py-2.5 rounded-xl font-black text-xs hover:bg-emerald-500/20 hover:text-emerald-400 transition";
                submitBtn.className = "w-full bg-red-500 text-white py-3.5 rounded-xl font-black text-xs tracking-wider uppercase hover:bg-red-600 transition";
                submitBtn.innerText = "EXECUTE SHORT POSITION";
            }
        }

        // Simulate Order Execution
        function executeTrade() {
            const amt = document.getElementById('amountIn').value || '100';
            showToast(`${selectedSide} Order executed for $${amt}!`, 'fa-bolt');
        }

        // Close Position
        function closePosition(btn) {
            btn.closest('tr').remove();
            document.getElementById('posCount').innerText = '0';
            showToast('Position closed successfully');
        }

        // Live Simulated Price Loop
        function startPriceTicker() {
            setInterval(() => {
                let delta = (Math.random() - 0.49) * (currentPrice * 0.001);
                currentPrice = parseFloat((currentPrice + delta).toFixed(2));

                // Update UI elements
                const pLive = document.getElementById('pLive');
                const priceIn = document.getElementById('priceIn');
                const obCurrentPrice = document.getElementById('obCurrentPrice');
                const markPriceTd = document.getElementById('markPriceTd');

                if (pLive) pLive.innerText = '$' + currentPrice.toLocaleString();
                if (priceIn) priceIn.value = currentPrice;
                if (obCurrentPrice) obCurrentPrice.innerText = currentPrice;
                if (markPriceTd) markPriceTd.innerText = '$' + currentPrice;

                // Dynamic Order Book Update
                updateOrderBook();
            }, 1200);
        }

        function updateOrderBook() {
            const asks = document.getElementById('orderBookAsks');
            const bids = document.getElementById('orderBookBids');

            if (!asks || !bids) return;

            asks.innerHTML = `
                <div class="flex justify-between text-red-400"><span>${(currentPrice + 1.2).toFixed(2)}</span><span class="text-zinc-500">${(Math.random()*1.5).toFixed(3)} BTC</span></div>
                <div class="flex justify-between text-red-400"><span>${(currentPrice + 0.7).toFixed(2)}</span><span class="text-zinc-500">${(Math.random()*1.1).toFixed(3)} BTC</span></div>
                <div class="flex justify-between text-red-400"><span>${(currentPrice + 0.3).toFixed(2)}</span><span class="text-zinc-500">${(Math.random()*0.8).toFixed(3)} BTC</span></div>
            `;

            bids.innerHTML = `
                <div class="flex justify-between text-emerald-400"><span>${(currentPrice - 0.3).toFixed(2)}</span><span class="text-zinc-500">${(Math.random()*0.9).toFixed(3)} BTC</span></div>
                <div class="flex justify-between text-emerald-400"><span>${(currentPrice - 0.8).toFixed(2)}</span><span class="text-zinc-500">${(Math.random()*1.7).toFixed(3)} BTC</span></div>
                <div class="flex justify-between text-emerald-400"><span>${(currentPrice - 1.4).toFixed(2)}</span><span class="text-zinc-500">${(Math.random()*2.1).toFixed(3)} BTC</span></div>
            `;
        }
    </script>
</body>
</html>
